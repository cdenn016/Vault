# Obsidian per-machine UI state (not shared across machines)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian trash / cache
.trash/
.obsidian/cache

# OS cruft
.DS_Store
Thumbs.db

# Downloaded source PDFs — local only (large binaries, not shared via git)
sources/pdfs/*.pdf
sources/pdfs/*.part

# LaTeX build artifacts — regenerated on every compile, never shared
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.toc
*.synctex.gz
__pycache__/
