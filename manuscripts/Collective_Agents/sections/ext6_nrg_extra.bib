@article{kawai2007dissipation,
  author  = {Kawai, R. and Parrondo, J. M. R. and Van den Broeck, C.},
  title   = {Dissipation: The Phase-Space Perspective},
  journal = {Physical Review Letters},
  volume  = {98},
  pages   = {080602},
  year    = {2007},
  doi     = {10.1103/PhysRevLett.98.080602},
  eprint  = {cond-mat/0701397},
  archiveprefix = {arXiv},
  annote  = {Opened 2026-11-09 (arXiv abstract page; independent check, same day). The result is for a Hamiltonian system driven between two equilibrium states: the average dissipated work equals k_B T times the relative entropy between the forward and backward phase-space densities taken at the same time. It is not a statement about stationary path laws. The manuscript uses the path relative entropy as a property of the path law and does not import the physical identification without the bath premise.}
}

