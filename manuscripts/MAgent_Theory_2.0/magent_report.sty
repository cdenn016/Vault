\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{magent_report}[2026/10/21 Compact scientific report style]
\RequirePackage[margin=1in,headheight=26pt]{geometry}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{amsmath,amssymb,amsthm,mathtools,mathrsfs,bm}
\RequirePackage{microtype,setspace,parskip}
\RequirePackage{xcolor,graphicx,booktabs,longtable,tabularx,array}
\RequirePackage{titlesec,fancyhdr}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{hyperref}
\definecolor{primaryblue}{RGB}{0,51,102}
\definecolor{secondaryblue}{RGB}{50,100,150}
\hypersetup{colorlinks=true,linkcolor=primaryblue,citecolor=secondaryblue,urlcolor=secondaryblue}
\titleformat{\chapter}[display]{\normalfont\huge\bfseries\raggedright\color{primaryblue}}
  {\chaptertitlename\ \thechapter}{12pt}{\Huge}
\titlespacing*{\chapter}{0pt}{-15pt}{25pt}
\titleformat{\section}{\normalfont\Large\bfseries\color{primaryblue}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\color{secondaryblue}}{\thesubsection}{0.8em}{}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\bfseries}{\theparagraph}{0.7em}{}
\titlespacing*{\paragraph}{0pt}{1.3ex}{0.7em}
\setstretch{1.08}
\setlength{\parskip}{0.42em}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{1.5em}
\clubpenalty=10000
\widowpenalty=10000
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\nouppercase{\leftmark}}
\fancyhead[R]{\small MAgent Theory 2.0}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
\newcommand{\magenttitle}[2]{%
  \begin{titlepage}\centering
  \vspace*{2.0cm}
  {\Huge\bfseries\color{primaryblue}#1\par}
  \vspace{1.1cm}
  {\Large #2\par}
  \vspace{2.1cm}
  {\Large Robert C. Dennis\par}
  \vspace{0.3cm}
  {Independent Researcher\par}
  \vfill
  {October 2026\par}
  \end{titlepage}}
\endinput
